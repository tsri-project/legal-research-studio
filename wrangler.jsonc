{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "legal-research-studio",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-22",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"vars": {
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": "",
		"DEEPSEEK_BASE_URL": "https://api.deepseek.com",
		"DEEPSEEK_MODEL": "deepseek-chat",
		"SUPABASE_URL": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "legal-research-studio-db",
			"database_id": "d292d353-883a-47ab-97c3-5b6b906f790d",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "RESEARCH_FILES",
			"bucket_name": "legal-research-studio-files"
		}
	]
}